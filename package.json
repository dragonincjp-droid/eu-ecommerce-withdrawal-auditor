{
  "name": "eu-withdrawal-omnibus-auditor",
  "version": "1.0.0",
  "description": "Zero-Playwright HTTP compliance auditor for EU Directive 2023/2673 Art. 11a Electronic Withdrawal Button (Widerrufsbutton), abolished EU ODR link traps, Directive 2024/825 EmpCo green claims, and Omnibus 30-day lowest price rules (Apify Actor + Standby MCP Server).",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dragonincjp-droid/eu-withdrawal-omnibus-auditor.git"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:standby": "node dist/main.js --standby",
    "test": "ALLOW_LOCALHOST_FOR_TESTS=1 node --test --test-force-exit tests/auditor.e2e.test.mjs",
    "typecheck": "node src/build.mjs --check",
    "lint": "node src/build.mjs --check"
  },
  "keywords": [
    "apify",
    "actor",
    "mcp",
    "eu-compliance",
    "withdrawal-button",
    "widerrufsbutton",
    "omnibus-directive",
    "empco",
    "greenwashing",
    "odr-link",
    "ecommerce",
    "lead-generation"
  ],
  "author": "Autonomous Venture Studio",
  "license": "MIT",
  "dependencies": {
    "apify": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
